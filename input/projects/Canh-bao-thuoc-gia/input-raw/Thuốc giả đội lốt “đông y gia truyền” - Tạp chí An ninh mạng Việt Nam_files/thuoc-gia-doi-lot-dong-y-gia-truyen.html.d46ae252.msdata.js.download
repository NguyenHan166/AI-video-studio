// resizeDetailPageImages()`}],quoteTemplateScripts:null,shadowTemplateList:[],pageParams:{article_id:22072,category_id:296,department_id:7,major_category_id:296,path:"/thuoc-gia-doi-lot-dong-y-gia-truyen",workflows_public_id:7},layoutName:"Bài viết - Căn giữa (1 cột)",serverErrors:null,notFoundPortletList:null}