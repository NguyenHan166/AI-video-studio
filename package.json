{
  "name": "ai-video-studio-antigravity",
  "version": "0.1.0",
  "private": true,
  "description": "Vietnamese SRT-driven editorial video starter for Antigravity + Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "dev": "remotion studio src/index.ts",
    "prepare": "node scripts/prepare-project.mjs",
    "prepare:demo": "node scripts/prepare-project.mjs --topic \"Sa Pa trong ký ức\" --srt input/demo.srt --slug demo",
    "check": "tsc --noEmit && node scripts/verify-project.mjs",
    "render": "node scripts/render-current.mjs",
    "still": "remotion still src/index.ts EditorialVideo output/preview.png --frame=75"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.3"
  }
}
